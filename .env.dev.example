# Dev-only Telegram credentials, so `pnpm dev` doesn't poll the same bot
# token as your installed Cerberus.app — two pollers on one token race for
# Telegram's updates, and whichever "loses" a given tap never sees it.
#
# 1. Create a second bot via https://t.me/BotFather (any name/username).
# 2. Copy this file: cp .env.dev.example .env.dev — the copy is gitignored,
#    this template isn't.
# 3. Fill in the two values below.
# 4. Launch with: CERBERUS_ENV_FILE=.env.dev pnpm dev
#    (CERBERUS_PORT is set here too, so it doesn't clash with the installed
#    app's daemon on 8898 either — see src/core/config.ts)
#
# loadEnvFile() (src/main/cerberus/env.ts) never overwrites a var already set
# in the environment, and CERBERUS_ENV_FILE has no default path — nothing
# reads this file unless you point at it explicitly.

TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
CERBERUS_PORT=8899
